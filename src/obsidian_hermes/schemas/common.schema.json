{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.obsidian-hermes.dev/v2/common.schema.json",
  "title": "Obsidian Hermes v2 common definitions",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "nullableString": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 4096
    },
    "catalogueId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 128,
      "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
    },
    "taskId": {
      "type": "string",
      "minLength": 31,
      "maxLength": 31,
      "pattern": "^task_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "commandId": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^cmd_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "runId": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "controlId": {
      "type": "string",
      "minLength": 34,
      "maxLength": 34,
      "pattern": "^control_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "approvalId": {
      "type": "string",
      "minLength": 35,
      "maxLength": 35,
      "pattern": "^approval_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "receiptId": {
      "type": "string",
      "minLength": 34,
      "maxLength": 34,
      "pattern": "^receipt_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "eventId": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^event_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "traceId": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^trace_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "spanId": {
      "type": "string",
      "minLength": 31,
      "maxLength": 31,
      "pattern": "^span_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "sourceId": {
      "type": "string",
      "minLength": 75,
      "maxLength": 75,
      "pattern": "^src_sha256_[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "rfc3339Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
    },
    "nullableTimestamp": {
      "oneOf": [
        {"$ref": "#/$defs/rfc3339Timestamp"},
        {"type": "null"}
      ]
    },
    "reviewDate": {
      "type": "string",
      "minLength": 10,
      "maxLength": 10,
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "vaultPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:ReadOnly|ReadWrite)/(?:[^/\\u0000-\\u001f\\\\*?\\[\\]]+/)*[^/\\u0000-\\u001f\\\\*?\\[\\]]+/?$",
      "allOf": [
        {"not": {"pattern": "(?:^|/)\\.\\.?(?:/|$)"}},
        {"not": {"pattern": "(?:^|/)Private(?:/|$)"}},
        {"not": {"pattern": "(?:^|/)\\.git(?:/|$)"}},
        {"not": {"pattern": "\\u007f"}}
      ]
    },
    "vaultGlob": {
      "oneOf": [
        {"$ref": "#/$defs/vaultPath"},
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?:ReadOnly|ReadWrite)/(?:\\*\\*|(?:[^/\\u0000-\\u001f\\\\*?\\[\\]]+/)*[^/\\u0000-\\u001f\\\\*?\\[\\]]+/\\*\\*)$",
          "allOf": [
            {"not": {"pattern": "(?:^|/)\\.\\.?(?:/|$)"}},
            {"not": {"pattern": "(?:^|/)Private(?:/|$)"}},
            {"not": {"pattern": "(?:^|/)\\.git(?:/|$)"}},
            {"not": {"pattern": "\\u007f"}}
          ]
        }
      ]
    },
    "readOnlyPath": {
      "allOf": [
        {"$ref": "#/$defs/vaultPath"},
        {"pattern": "^ReadOnly/"}
      ]
    },
    "readWritePath": {
      "allOf": [
        {"$ref": "#/$defs/vaultPath"},
        {"pattern": "^ReadWrite/"}
      ]
    },
    "readWriteGlob": {
      "allOf": [
        {"$ref": "#/$defs/vaultGlob"},
        {"pattern": "^ReadWrite/"}
      ]
    },
    "destination": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^(?:\\[[0-9A-Fa-f:]+\\]|[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::[0-9]{1,5})?$",
      "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
    },
    "modelPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name"],
      "properties": {
        "provider": {"$ref": "#/$defs/nonEmptyString"},
        "name": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "requiredAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "key_id", "signature"],
      "properties": {
        "method": {"enum": ["local-bridge", "signature"]},
        "key_id": {"$ref": "#/$defs/nonEmptyString"},
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      }
    },
    "nullableAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "key_id", "signature"],
      "properties": {
        "method": {"type": ["string", "null"], "enum": ["local-bridge", "signature", null]},
        "key_id": {"$ref": "#/$defs/nullableString"},
        "signature": {"type": ["string", "null"], "minLength": 1, "maxLength": 8192}
      }
    }
  }
}
