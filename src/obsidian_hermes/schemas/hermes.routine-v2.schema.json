{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.obsidian-hermes.dev/v2/hermes.routine.json",
  "title": "hermes.routine/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "id",
    "revision",
    "desired_state",
    "name",
    "schedule",
    "execution",
    "permissions_maximum",
    "limits",
    "approval",
    "observed"
  ],
  "properties": {
    "schema": {"const": "hermes.routine/v2"},
    "schema_version": {"const": 2},
    "id": {"$ref": "common.schema.json#/$defs/catalogueId"},
    "revision": {"$ref": "common.schema.json#/$defs/revision"},
    "desired_state": {"enum": ["draft", "active", "paused", "absent"]},
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)+$"
    },
    "schedule": {"$ref": "#/$defs/schedule"},
    "execution": {
      "oneOf": [
        {"$ref": "#/$defs/scriptOnlyExecution"},
        {"$ref": "#/$defs/scriptGatedAgentExecution"},
        {"$ref": "#/$defs/agentExecution"}
      ]
    },
    "permissions_maximum": {"$ref": "#/$defs/permissionsMaximum"},
    "limits": {"$ref": "#/$defs/limits"},
    "approval": {"$ref": "#/$defs/approval"},
    "observed": {"$ref": "#/$defs/observed"}
  },
  "$defs": {
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "timezone"],
      "properties": {
        "expression": {
          "type": "string",
          "oneOf": [
            {"pattern": "^every [1-9][0-9]*[mh]$"},
            {"pattern": "^(?:[0-5]?[0-9]) (?:[01]?[0-9]|2[0-3]) \\* \\* \\*$"}
          ]
        },
        "timezone": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*$",
          "allOf": [
            {"not": {"pattern": "(?:^|/)\\.\\.?(?:/|$)"}}
          ]
        }
      }
    },
    "scriptOnlyExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "capability", "workdir", "script"],
      "properties": {
        "mode": {"const": "script-only"},
        "capability": {"$ref": "common.schema.json#/$defs/catalogueId"},
        "workdir": {"const": "/workspace/obsidian"},
        "script": {"$ref": "common.schema.json#/$defs/catalogueId"}
      }
    },
    "scriptGatedAgentExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "capability",
        "workdir",
        "script",
        "agent_profile",
        "provider",
        "model"
      ],
      "properties": {
        "mode": {"const": "script-gated-agent"},
        "capability": {"$ref": "common.schema.json#/$defs/catalogueId"},
        "workdir": {"const": "/workspace/obsidian"},
        "script": {"$ref": "common.schema.json#/$defs/catalogueId"},
        "agent_profile": {"$ref": "common.schema.json#/$defs/catalogueId"},
        "provider": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "model": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
      }
    },
    "agentExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "capability", "workdir", "agent_profile", "provider", "model"],
      "properties": {
        "mode": {"const": "agent"},
        "capability": {"$ref": "common.schema.json#/$defs/catalogueId"},
        "workdir": {"const": "/workspace/obsidian"},
        "agent_profile": {"$ref": "common.schema.json#/$defs/catalogueId"},
        "provider": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "model": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
      }
    },
    "permissionsMaximum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "read", "write", "external_effects", "destructive_write"],
      "properties": {
        "network": {"enum": ["deny", "allowlist"]},
        "read": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/vaultGlob"},
          "uniqueItems": true,
          "maxItems": 128
        },
        "write": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/readWriteGlob"},
          "uniqueItems": true,
          "maxItems": 128
        },
        "external_effects": {"const": "deny"},
        "destructive_write": {"const": "deny"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_items_per_run", "max_runtime_minutes"],
      "properties": {
        "max_items_per_run": {"type": "integer", "minimum": 1},
        "max_runtime_minutes": {"type": "integer", "minimum": 1}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_for_change", "approval_id", "approved_spec_hash"],
      "properties": {
        "required_for_change": {"const": true},
        "approval_id": {
          "oneOf": [{"$ref": "common.schema.json#/$defs/approvalId"}, {"type": "null"}]
        },
        "approved_spec_hash": {
          "oneOf": [{"$ref": "common.schema.json#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "native_job_id",
        "applied_revision",
        "applied_spec_hash",
        "last_reconciled_at",
        "last_error"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending",
            "in_sync",
            "out_of_sync",
            "reconciling",
            "paused",
            "degraded",
            "invalid",
            "blocked",
            "absent"
          ]
        },
        "native_job_id": {"$ref": "common.schema.json#/$defs/nullableString"},
        "applied_revision": {
          "oneOf": [{"$ref": "common.schema.json#/$defs/revision"}, {"type": "null"}]
        },
        "applied_spec_hash": {
          "oneOf": [{"$ref": "common.schema.json#/$defs/sha256"}, {"type": "null"}]
        },
        "last_reconciled_at": {"$ref": "common.schema.json#/$defs/nullableTimestamp"},
        "last_error": {"$ref": "common.schema.json#/$defs/nullableString"}
      }
    }
  }
}
