{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.obsidian-hermes.dev/v2/hermes.run.json",
  "title": "hermes.run/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "id",
    "task_id",
    "task_generation",
    "command_id",
    "trace_id",
    "state",
    "agent_profile",
    "model",
    "created_at",
    "started_at",
    "finished_at",
    "context_manifest",
    "skills_used",
    "usage",
    "outputs",
    "approval_ids",
    "receipt_id",
    "last_checkpoint",
    "error"
  ],
  "properties": {
    "schema": {"const": "hermes.run/v2"},
    "schema_version": {"const": 2},
    "id": {"$ref": "common.schema.json#/$defs/runId"},
    "task_id": {"$ref": "common.schema.json#/$defs/taskId"},
    "task_generation": {"type": "integer", "minimum": 1},
    "command_id": {"$ref": "common.schema.json#/$defs/commandId"},
    "trace_id": {"$ref": "common.schema.json#/$defs/traceId"},
    "state": {
      "enum": [
        "claimed",
        "running",
        "awaiting_approval",
        "retry_scheduled",
        "verifying",
        "completed",
        "blocked",
        "failed",
        "cancelled",
        "dead_letter",
        "superseded"
      ]
    },
    "agent_profile": {"$ref": "common.schema.json#/$defs/catalogueId"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "source"],
      "properties": {
        "provider": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "name": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "source": {"enum": ["routine", "agent_profile"]}
      }
    },
    "created_at": {"$ref": "common.schema.json#/$defs/rfc3339Timestamp"},
    "started_at": {"$ref": "common.schema.json#/$defs/nullableTimestamp"},
    "finished_at": {"$ref": "common.schema.json#/$defs/nullableTimestamp"},
    "context_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "reason"],
        "properties": {
          "ref": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "reason": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
        }
      },
      "maxItems": 256
    },
    "skills_used": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/catalogueId"},
      "uniqueItems": true,
      "maxItems": 32
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "network_requests"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "network_requests": {"type": "integer", "minimum": 0}
      }
    },
    "outputs": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/vaultPath"},
      "uniqueItems": true,
      "maxItems": 256
    },
    "approval_ids": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/approvalId"},
      "uniqueItems": true,
      "maxItems": 64
    },
    "receipt_id": {
      "oneOf": [{"$ref": "common.schema.json#/$defs/receiptId"}, {"type": "null"}]
    },
    "last_checkpoint": {"$ref": "common.schema.json#/$defs/nullableString"},
    "error": {"$ref": "common.schema.json#/$defs/nullableString"}
  }
}
